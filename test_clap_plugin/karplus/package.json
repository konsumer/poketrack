{
  "name": "karplus-clap",
  "version": "1.0.0",
  "description": "Karplus-Strong plucked string — WCLAP instrument written in AssemblyScript",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "asbuild:debug": "asc assembly/index.ts --target debug",
    "asbuild:release": "asc assembly/index.ts --target release",
    "asbuild": "npm run asbuild:debug && npm run asbuild:release",
    "build": "npm run asbuild:release && cp build/release.wasm ../karplus.wclap.wasm"
  },
  "dependencies": {
    "@assemblyscript/wasi-shim": "^0.1.0",
    "as-clap": "github:WebCLAP/as-clap",
    "assemblyscript": "^0.28.9"
  }
}
